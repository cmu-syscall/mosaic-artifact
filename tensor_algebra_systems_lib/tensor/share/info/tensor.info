1.10 Examples
=============

The following code examples show basic use of Tensor 0.1.  Allocation,
initialisation and reading from a tensor can be done with the functions
*note tensor_alloc(): function_tensor_alloc, *note tensor_set():
function_tensor_set, *note tensor_get(): function_tensor_get, as in the
program below:

#include <stdio.h>
#include <tensor/tensor.h>

int
main (void)
{
  tensor * t = tensor_alloc (3, 2, 3, 4);

  size_t i, j, k;

  for (i = 0; i < 2; ++i)
    for (j = 0; j < 3; ++j)
      for (k = 0; k < 4; ++k)
        {
          tensor_set (t, i * 0.2 + j * 0.3 + k, i, j, k);
        }

  for (i = 0; i < 3; ++i)       /* INDEX OUT OF RANGE ERROR */
    for (j = 0; j < 3; ++j)
      for (k = 0; k < 4; ++k)
        {
          printf ("t (%zu, %zu, %zu) = %g\n", i, j, k, 
                  tensor_get (t, i, j, k));
        }

  tensor_free (t);

  return 0;
}

   The element values of the tensor are printed in the output of the
program.  The outer loop attempts to access outside of the range of the
tensor ‘t’, which produces an error caught by the range-checking code.

t (0, 0, 0) = 0
t (0, 0, 1) = 1
t (0, 0, 2) = 2
t (0, 0, 3) = 3
t (0, 1, 0) = 0.3
t (0, 1, 1) = 1.3
t (0, 1, 2) = 2.3
t (0, 1, 3) = 3.3
t (0, 2, 0) = 0.6
...
t (1, 2, 3) = 3.8

gsl: ../../tensor/prop_source.c:40: ERROR: index 2 out of range for
tensor dim 0 of size 2
Default GSL error handler invoked.
Aborted (core dumped)

   The next example demonstrates writing/reading a tensor to/from a
file.

#include <stdio.h>
#include <tensor/tensor.h>

int
main (void)
{
  size_t i, j, k, diff = 0;
  double t_el, u_el;
  
  tensor * t = tensor_alloc (3, 10, 10, 10);
  tensor * u = tensor_alloc (3, 10, 10, 10);

  for (i = 0; i < 10; ++i)
    for (j = 0; j < 10; ++j)
      for (k = 0; k < 10; ++k)
        {
          tensor_set (t, i * 0.2 + j * 0.3 + k, i, j, k);
        }

  FILE * f = fopen ("test.dat", "wb");
  tensor_fwrite (f, t);
  fclose (f);

  f = fopen ("test.dat", "rb");
  tensor_fread (f, u);
  fclose (f);

  for (i = 0; i < 10; ++i)
    for (j = 0; j < 10; ++j)
      for (k = 0; k < 10; ++k)
        {
          t_el = tensor_get (t, i, j, k);
          u_el = tensor_get (u, i, j, k);

          if (t_el != u_el)
            ++diff;
        }

  tensor_free (t);
  tensor_free (u);

  printf ("differences = %zu (should be zero)\n", diff);
  
  return (diff > 0);
}

   After running the program, a binary ‘test.dat’ file should contain
the elements of tensor ‘t’.  The tensor ‘u’ that is read back in from
the file should be identical to ‘t’.

   The following program shows the use of tensor views to set the
elements of a tensor of ‘dim 3’ to ‘0’ at places where both the row and
column index are even.

#include <stdio.h>
#include <tensor/tensor.h>

int
main (void)
{
  tensor * t = tensor_alloc (3, 2, 3, 4);

  size_t i, j, k;

  for (i = 0; i < 2; ++i)
    for (j = 0; j < 3; ++j)
      for (k = 0; k < 4; ++k)
        {
          tensor_set (t, i * 0.2 + j * 0.3 + k, i, j, k);
        }

  printf("Tensor t elements: \n");
  
  for (i = 0; i < t->size[0]; ++i)
      for (j = 0; j < t->size[1]; ++j)
          for (k = 0; k < t->size[2]; ++k)
            {
              printf ("t (%zu, %zu, %zu) = %g\n", i, j, k, 
                      tensor_get (t, i, j, k));
            }

  tensor * v = tensor_view (t,
                            RANGE (0, t->size[0], 1),
                            RANGE (0, t->size[1], 2),
                            RANGE (0, t->size[2], 2));

  /* Sets elements where both row and column index is even to zero */
  tensor_set_zero (v);

  printf("\n");
  printf("Tensor t elements: \n");
  
  for (i = 0; i < t->size[0]; ++i)
      for (j = 0; j < t->size[1]; ++j)
          for (k = 0; k < t->size[2]; ++k)
            {
              printf ("t (%zu, %zu, %zu) = %g\n", i, j, k, 
                      tensor_get (t, i, j, k));
            }

  tensor_free (v);
  tensor_free (t);

  return 0;
}


